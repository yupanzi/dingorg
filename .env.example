# 复制成 .env 后填写。本文件进版本库，不要写真实密钥。
# 常驻服务与一次性任务（migrate、oidcpurge、orgsync）读同一份，各取所需。

# ─────────────────── 必填 ───────────────────

DATABASE_URL="postgresql://dingorg_user:password@localhost:5432/dingorg"

# 自有钉钉企业内部应用的凭证：扫码登录、拉组织快照，它的通讯录决定谁能登录。
# 只有本服务持有，下游用 client 凭证、REST 调用方用 API key。钉钉后台要配的见 README「钉钉开放平台配置清单」。
DINGTALK_APP_KEY=""
DINGTALK_APP_SECRET=""

# 下游 OIDC client 与 REST API key 的 JSON 数组，按 type 区分：至少一个 oidc 项；没有 apikey 项
# = 不开 REST 面。用生成命令产出，--merge 从 stdin 读现有值、输出接上新项的完整数组：
#   pnpm -s auth:oidc --name local --redirect-uri http://localhost:9000/callback
#   echo "$AUTH_JSON" | pnpm -s auth:apikey --name <调用方> --merge   # 其中的 key 交给调用方
AUTH_JSON=''

# ─────────────────── 可选（本地开发全部可留空）───────────────────

# 对外可达的 origin（协议 + 域名 [+ 端口]，不带路径），issuer 是它加 /oidc。要与钉钉后台的
# 回调域名一致；https 意味着前面有代理，会信任 x-forwarded-*。
# 留空 = http://localhost:3080（本服务固定监听 3080），只在非 production 时生效，镜像里必填。
PUBLIC_ORIGIN=""

# fatal / error / warn / info / debug / trace / silent，留空即 info。测试默认 silent
LOG_LEVEL=""
