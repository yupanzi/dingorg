# 复制成 .env 后填写。本文件进版本库，不要写真实密钥。
# 常驻服务与一次性任务（migrate、oidcpurge、orgsync）读同一份，各取所需。

# ─────────────────── 必填 ───────────────────

DATABASE_URL="postgresql://dingorg_user:password@localhost:5432/dingorg"

# 自有钉钉企业内部应用的凭证：扫码登录、每日同步，它的通讯录决定谁能登录。
# 不是下游的 OIDC 凭证。钉钉后台要配的见 README「钉钉开放平台配置清单」。
DINGTALK_APP_KEY=""
DINGTALK_APP_SECRET=""

# 必须与对外可达地址精确一致、尾部不带斜杠。origin 要与钉钉后台的回调域名一致。
OIDC_ISSUER="http://localhost:3080/oidc"

# 下游 OIDC client 的 JSON 数组（含 secret），用生成命令产出后整行粘进来：
#   pnpm -s oidc:new-client --name local --redirect-uri http://localhost:9000/callback
OIDC_CLIENTS_JSON=''

# ─────────────────── 可选（本地开发全部可留空）───────────────────

# 挂 Ingress / 反向代理时必须置 1（信任 x-forwarded-*）
AUTH_TRUST_PROXY_HEADERS=""

# 直连时改它要同时改 OIDC_ISSUER
IDP_PORT="3080"

# fatal / error / warn / info / debug / trace / silent，留空即 info。测试默认 silent
LOG_LEVEL=""

# `pnpm orgsync` 调用本服务的地址，只写 origin，留空即 http://localhost:3080
DINGORG_URL=""
